#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

TRANSPARENT_FILE="/etc/mihomo/transparent"
ENABLED_FILE="/etc/mihomo/enabled"

should_start() {
    if [ -f "$ENABLED_FILE" ] && [ "$(cat $ENABLED_FILE)" = "0" ]; then
        return 1
    fi
    return 0
}

start_service() {
    if ! should_start; then
        logger -t dinoclash "DinoClash disabled by user"
        return 0
    fi
    
    procd_open_instance mihomo
    procd_set_param command /usr/bin/mihomo -d /etc/mihomo
    procd_set_param respawn 3600 5 5
    procd_set_param limits nofile="1048576 1048576"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/mihomo.pid
    procd_close_instance
    
    sleep 3
    
    if [ -f "$TRANSPARENT_FILE" ] && [ "$(cat $TRANSPARENT_FILE)" = "1" ]; then
        setup_transparent
    fi
    
    logger -t dinoclash "DinoClash started"
}

stop_service() {
    cleanup_transparent
    logger -t dinoclash "DinoClash stopped"
}

setup_transparent() {
    LAN_IF=$(uci get network.lan.device 2>/dev/null || echo "br-lan")
    sed -i "s/iifname != \"[^\"]*\"/iifname != \"$LAN_IF\"/g" /etc/mihomo/nft.conf 2>/dev/null
    
    # Try nftables first (OpenWrt 22.03+)
    if command -v nft >/dev/null 2>&1; then
        nft -f /etc/mihomo/nft.conf 2>/dev/null || true
        logger -t dinoclash "Transparent proxy: nftables"
    # Fallback to iptables (OpenWrt 21.02)
    elif command -v iptables >/dev/null 2>&1; then
        iptables -t nat -N DINOCLASH 2>/dev/null || iptables -t nat -F DINOCLASH
        iptables -t nat -A DINOCLASH -d 0.0.0.0/8 -j RETURN
        iptables -t nat -A DINOCLASH -d 10.0.0.0/8 -j RETURN
        iptables -t nat -A DINOCLASH -d 127.0.0.0/8 -j RETURN
        iptables -t nat -A DINOCLASH -d 169.254.0.0/16 -j RETURN
        iptables -t nat -A DINOCLASH -d 172.16.0.0/12 -j RETURN
        iptables -t nat -A DINOCLASH -d 192.168.0.0/16 -j RETURN
        iptables -t nat -A DINOCLASH -d 224.0.0.0/4 -j RETURN
        iptables -t nat -A DINOCLASH -d 240.0.0.0/4 -j RETURN
        iptables -t nat -A DINOCLASH -p udp --dport 53 -j REDIRECT --to-ports 1053
        iptables -t nat -A DINOCLASH -p tcp --dport 53 -j REDIRECT --to-ports 1053
        iptables -t nat -A DINOCLASH -p udp --dport 443 -j REDIRECT --to-ports 7892
        iptables -t nat -A DINOCLASH -p tcp -j REDIRECT --to-ports 7892
        iptables -t nat -A PREROUTING -i $LAN_IF -j DINOCLASH
        logger -t dinoclash "Transparent proxy: iptables (legacy)"
    else
        logger -t dinoclash "WARNING: No firewall tool found!"
    fi
}

cleanup_transparent() {
    # Cleanup nftables
    nft delete table inet mihomo 2>/dev/null || true
    
    # Cleanup iptables
    if command -v iptables >/dev/null 2>&1; then
        LAN_IF=$(uci get network.lan.device 2>/dev/null || echo "br-lan")
        iptables -t nat -D PREROUTING -i $LAN_IF -j DINOCLASH 2>/dev/null || true
        iptables -t nat -F DINOCLASH 2>/dev/null || true
        iptables -t nat -X DINOCLASH 2>/dev/null || true
    fi
}

service_triggers() {
    procd_add_reload_trigger "mihomo"
}
