#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

TRANSPARENT_FILE="/etc/mihomo/transparent"
ENABLED_FILE="/etc/mihomo/enabled"

# Check if user wants mihomo to auto-start
should_start() {
    # Default: enabled (1)
    # If enabled file says "0", don't auto-start
    if [ -f "$ENABLED_FILE" ] && [ "$(cat $ENABLED_FILE)" = "0" ]; then
        return 1
    fi
    return 0
}

start_service() {
    # Check if enabled by user
    if ! should_start; then
        logger -t mihomo "Mihomo is disabled by user, not starting"
        return 0
    fi
    
    procd_open_instance mihomo
    procd_set_param command /usr/bin/mihomo -d /etc/mihomo
    procd_set_param respawn 3600 5 5
    procd_set_param limits nofile="1048576 1048576"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/mihomo.pid
    procd_close_instance
    
    sleep 3
    
    if [ -f "$TRANSPARENT_FILE" ] && [ "$(cat $TRANSPARENT_FILE)" = "1" ]; then
        setup_transparent
    fi
    
    logger -t mihomo "Mihomo started (user preference: enabled)"
}

stop_service() {
    cleanup_transparent
    logger -t mihomo "Mihomo stopped"
}

setup_transparent() {
    # Auto-detect LAN interface
    LAN_IF=$(uci get network.lan.device 2>/dev/null || echo "br-lan")
    
    # Update nft.conf with detected LAN interface
    sed -i "s/iifname != \"[^\"]*\"/iifname != \"$LAN_IF\"/g" /etc/mihomo/nft.conf 2>/dev/null
    
    # Apply firewall rules
    nft -f /etc/mihomo/nft.conf 2>/dev/null || true
}

cleanup_transparent() {
    nft delete table inet mihomo 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "mihomo"
}
