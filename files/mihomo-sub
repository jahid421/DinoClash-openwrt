#!/bin/sh
# ═══════════════════════════════════════════════
# 🦕 DinoClash - Ultra Speed Subscription Optimizer
# Developer: Jahid Hasan Shuvo
# ═══════════════════════════════════════════════

echo "Content-Type: text/plain"
echo ""

RAW=$(echo "$QUERY_STRING" | sed -n 's/.*url=\(.*\)$/\1/p')
URL=$(printf '%b' "$(echo "$RAW" | sed 's/+/ /g; s/%/\\x/g')")
TMP="/tmp/mhsub_$$.yaml"

# Cleanup on exit
trap "rm -f ${TMP}.opt ${TMP}.lazy ${TMP}.new /tmp/mhsub_err.log" EXIT

if [ -z "$URL" ]; then
    echo "NO_URL"
    exit 0
fi

# URL scheme validation
case "$URL" in
    http://*|https://*)
        ;;
    *)
        echo "INVALID_URL"
        exit 0
        ;;
esac

curl -sL --connect-timeout 20 --max-time 120 -H "User-Agent: DinoClash/1.0" -o "$TMP" "$URL" 2>/dev/null

if [ -s "$TMP" ]; then
    if ! grep -q "^proxies:\|^proxy-providers:" "$TMP"; then
        rm -f "$TMP"
        echo "INVALID_FORMAT"
        exit 0
    fi
    
    # SPEED OPTIMIZATION
    awk '
    BEGIN { in_group=0 }
    /^  - name:/ { in_group=1 }
    /^[a-z]/ && !/^  / { in_group=0 }
    {
        if (in_group && /^    strategy: round-robin$/) {
            print "    strategy: consistent-hashing"
            next
        }
        print
    }
    ' "$TMP" > "${TMP}.opt" && mv "${TMP}.opt" "$TMP"
    
    sed -i 's/interval: 300/interval: 120/g' "$TMP"
    sed -i 's/interval: 600/interval: 120/g' "$TMP"
    sed -i 's/interval: 180/interval: 120/g' "$TMP"
    sed -i 's/tolerance: 50/tolerance: 20/g' "$TMP"
    sed -i 's/tolerance: 100/tolerance: 20/g' "$TMP"
    sed -i 's/tolerance: 30/tolerance: 20/g' "$TMP"
    
    awk '
    BEGIN { in_urltest=0; has_lazy=0 }
    /^  - name:/ {
        if (in_urltest && !has_lazy) print "    lazy: true"
        in_urltest=0; has_lazy=0
    }
    /^    type: url-test/ { in_urltest=1 }
    /^    lazy:/ { has_lazy=1 }
    /^[a-z]/ && !/^  / {
        if (in_urltest && !has_lazy) print "    lazy: true"
        in_urltest=0; has_lazy=0
    }
    { print }
    END { if (in_urltest && !has_lazy) print "    lazy: true" }
    ' "$TMP" > "${TMP}.lazy" && mv "${TMP}.lazy" "$TMP"
    
    # REQUIRED SETTINGS (busybox compatible)
    add_if_missing() {
        local key="$1"
        local line="$2"
        if ! grep -q "^${key}" "$TMP"; then
            { echo "$line"; cat "$TMP"; } > "${TMP}.new" && mv "${TMP}.new" "$TMP"
        fi
    }
    
    add_if_missing "mixed-port:" "mixed-port: 7890"
    add_if_missing "redir-port:" "redir-port: 7892"
    add_if_missing "allow-lan:" "allow-lan: true"
    add_if_missing "bind-address:" "bind-address: '*'"
    add_if_missing "mode:" "mode: rule"
    add_if_missing "log-level:" "log-level: info"
    
    grep -q '^external-controller:' "$TMP" || echo 'external-controller: 0.0.0.0:9595' >> "$TMP"
    grep -q '^external-ui:' "$TMP" || echo 'external-ui: /etc/mihomo/ui' >> "$TMP"
    grep -q '^secret:' "$TMP" || echo 'secret: "flclash123"' >> "$TMP"
    grep -q '^tcp-concurrent:' "$TMP" || echo 'tcp-concurrent: true' >> "$TMP"
    grep -q '^unified-delay:' "$TMP" || echo 'unified-delay: true' >> "$TMP"
    grep -q '^keep-alive-interval:' "$TMP" || echo 'keep-alive-interval: 10' >> "$TMP"
    grep -q '^keep-alive-idle:' "$TMP" || echo 'keep-alive-idle: 10' >> "$TMP"
    
    # SECTIONS
    if ! grep -q '^profile:' "$TMP"; then
        printf '\nprofile:\n  store-selected: true\n  store-fake-ip: true\n  tracing: false\n' >> "$TMP"
    fi
    
    if ! grep -q '^sniffer:' "$TMP"; then
        cat >> "$TMP" << 'SEOF'

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]
SEOF
    fi
    
    if ! grep -q '^tun:' "$TMP"; then
        cat >> "$TMP" << 'TEOF'

tun:
  enable: false
  stack: system
  device: utun
  auto-route: true
  auto-detect-interface: true
  strict-route: false
  mtu: 1500
  dns-hijack:
    - "any:53"
  inet4-address:
    - 172.19.0.1/30
TEOF
    else
        sed -i '/^tun:/,/^[a-z]/ s/^  enable: true$/  enable: false/' "$TMP"
    fi
    
    if ! grep -q '^dns:' "$TMP"; then
        cat >> "$TMP" << 'DEOF'

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: redir-host
  default-nameserver:
    - 223.5.5.5
    - 1.1.1.1
    - 8.8.8.8
    - 114.114.114.114
  nameserver:
    - https://1.1.1.1/dns-query
    - https://dns.google/dns-query
  fallback:
    - tls://1.1.1.1:853
    - tls://dns.google:853
  nameserver-policy:
    '+.google.com': 'https://dns.google/dns-query'
    '+.facebook.com': 'https://1.1.1.1/dns-query'
    '+.youtube.com': 'https://dns.google/dns-query'
DEOF
    else
        sed -i 's/enhanced-mode: fake-ip/enhanced-mode: redir-host/g' "$TMP"
        sed -i 's/prefer-h3: true/prefer-h3: false/g' "$TMP"
        if ! grep -q "114.114.114.114" "$TMP"; then
            sed -i '/default-nameserver:/a\    - 114.114.114.114' "$TMP"
        fi
    fi
    
    # LAN SAFETY
    LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
    LAN_NET=$(echo "$LAN_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')
    
    if grep -q '^rules:' "$TMP"; then
        sed -i '/192.168.87.0\/24,DIRECT/d' "$TMP"
        sed -i '/192.168.64.0\/24,DIRECT/d' "$TMP"
        if ! grep -q "$LAN_NET,DIRECT" "$TMP"; then
            sed -i "/^rules:/a\\
  - 'IP-CIDR,$LAN_NET,DIRECT,no-resolve'\\
  - 'DST-PORT,9595,DIRECT'" "$TMP"
        fi
    fi
    
    # VALIDATE
    if /usr/bin/mihomo -d /etc/mihomo -f "$TMP" -t 2>/tmp/mhsub_err.log; then
        cp /etc/mihomo/config.yaml /etc/mihomo/config.yaml.bak 2>/dev/null
        mv "$TMP" /etc/mihomo/config.yaml
        echo "1" > /etc/mihomo/transparent
        echo "1" > /etc/mihomo/enabled
        /etc/init.d/mihomo restart >/dev/null 2>&1
        echo "OK"
    else
        ERR=$(cat /tmp/mhsub_err.log 2>/dev/null | head -3)
        rm -f "$TMP"
        echo "INVALID: $ERR"
    fi
else
    rm -f "$TMP"
    echo "DOWNLOAD_FAILED"
fi
