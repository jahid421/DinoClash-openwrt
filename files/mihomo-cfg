#!/bin/sh
# ═══════════════════════════════════════════════
# Ultimate YAML Auto-Optimizer for FLClash
# High Speed + Low Latency + Load Balancing
# Works with ANY YAML config
# ═══════════════════════════════════════════════

echo "Content-Type: text/plain"
echo ""

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/mhcfg_$$.yaml"
    cat > "$TMP"
    
    if [ -s "$TMP" ]; then
        # ═══════════════════════════════════════════
        # STEP 1: SPEED + LOAD BALANCE OPTIMIZATION
        # ═══════════════════════════════════════════
        
        # Convert to url-test with fallback (best speed + reliability)
        # Keep load-balance as is (but with consistent-hashing)
        awk '
        BEGIN { in_group=0 }
        /^  - name:/ { in_group=1 }
        /^[a-z]/ && !/^  / { in_group=0 }
        {
            # url-test → keep (already optimized)
            # load-balance → keep with consistent-hashing
            # Just fix strategy for load-balance
            if (in_group && /^    strategy: round-robin$/) {
                print "    strategy: consistent-hashing"
                next
            }
            print
        }
        ' "$TMP" > "${TMP}.opt" && mv "${TMP}.opt" "$TMP"
        
        # Speed optimizations
        sed -i 's/interval: 300/interval: 180/g' "$TMP"
        sed -i 's/interval: 600/interval: 180/g' "$TMP"
        sed -i 's/interval: 900/interval: 180/g' "$TMP"
        sed -i 's/tolerance: 50/tolerance: 30/g' "$TMP"
        sed -i 's/tolerance: 100/tolerance: 30/g' "$TMP"
        sed -i 's/tolerance: 150/tolerance: 30/g' "$TMP"
        
        # Add lazy: true to url-test groups
        awk '
        BEGIN { in_urltest=0; has_lazy=0; group_name="" }
        /^  - name:/ {
            if (in_urltest && !has_lazy) {
                print "    lazy: true"
            }
            in_urltest=0
            has_lazy=0
            group_name=$0
        }
        /^    type: url-test/ { in_urltest=1 }
        /^    lazy:/ { has_lazy=1 }
        /^[a-z]/ && !/^  / {
            if (in_urltest && !has_lazy) {
                print "    lazy: true"
            }
            in_urltest=0
            has_lazy=0
        }
        { print }
        END {
            if (in_urltest && !has_lazy) {
                print "    lazy: true"
            }
        }
        ' "$TMP" > "${TMP}.lazy" && mv "${TMP}.lazy" "$TMP"
        
        # ═══════════════════════════════════════════
        # STEP 2: HIGH SPEED SETTINGS
        # ═══════════════════════════════════════════
        grep -q '^mixed-port:' "$TMP" || sed -i '1i mixed-port: 7890' "$TMP"
        grep -q '^redir-port:' "$TMP" || sed -i '1i redir-port: 7892' "$TMP"
        grep -q '^allow-lan:' "$TMP" || sed -i '1i allow-lan: true' "$TMP"
        grep -q "^bind-address:" "$TMP" || sed -i "1i bind-address: '*'" "$TMP"
        grep -q '^mode:' "$TMP" || sed -i '1i mode: rule' "$TMP"
        grep -q '^log-level:' "$TMP" || sed -i '1i log-level: warning' "$TMP"
        grep -q '^ipv6:' "$TMP" || sed -i '1i ipv6: false' "$TMP"
        grep -q '^external-controller:' "$TMP" || echo 'external-controller: 0.0.0.0:9595' >> "$TMP"
        grep -q '^external-ui:' "$TMP" || echo 'external-ui: /etc/mihomo/ui' >> "$TMP"
        grep -q '^secret:' "$TMP" || echo 'secret: "flclash123"' >> "$TMP"
        grep -q '^geodata-mode:' "$TMP" || echo 'geodata-mode: true' >> "$TMP"
        grep -q '^find-process-mode:' "$TMP" || echo 'find-process-mode: "off"' >> "$TMP"
        grep -q '^global-client-fingerprint:' "$TMP" || echo 'global-client-fingerprint: chrome' >> "$TMP"
        
        # Speed boost settings
        grep -q '^tcp-concurrent:' "$TMP" || echo 'tcp-concurrent: true' >> "$TMP"
        grep -q '^unified-delay:' "$TMP" || echo 'unified-delay: true' >> "$TMP"
        grep -q '^keep-alive-interval:' "$TMP" || echo 'keep-alive-interval: 30' >> "$TMP"
        
        # ═══════════════════════════════════════════
        # STEP 3: Profile
        # ═══════════════════════════════════════════
        if ! grep -q '^profile:' "$TMP"; then
            cat >> "$TMP" << 'PEOF'

profile:
  store-selected: true
  store-fake-ip: true
PEOF
        fi
        
        # ═══════════════════════════════════════════
        # STEP 4: Sniffer (better routing)
        # ═══════════════════════════════════════════
        if ! grep -q '^sniffer:' "$TMP"; then
            cat >> "$TMP" << 'SEOF'

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]
SEOF
        fi
        
        # ═══════════════════════════════════════════
        # STEP 5: TUN (disabled - use redirect mode)
        # ═══════════════════════════════════════════
        if ! grep -q '^tun:' "$TMP"; then
            cat >> "$TMP" << 'TEOF'

tun:
  enable: false
  stack: system
  device: utun
  auto-route: true
  auto-detect-interface: true
  strict-route: false
  mtu: 1500
  dns-hijack:
    - "any:53"
  inet4-address:
    - 172.19.0.1/30
TEOF
        else
            sed -i '/^tun:/,/^[a-z]/ s/^  enable: true$/  enable: false/' "$TMP"
        fi
        
        # ═══════════════════════════════════════════
        # STEP 6: Fast DNS (Fake-IP)
        # ═══════════════════════════════════════════
        if ! grep -q '^dns:' "$TMP"; then
            cat >> "$TMP" << 'DEOF'

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.localhost'
    - '+.arpa'
    - 'dns.msftncsi.com'
    - 'time.*'
    - 'ntp.*'
    - '+.pool.ntp.org'
    - '*.msftconnecttest.com'
    - '*.msftncsi.com'
  default-nameserver:
    - 223.5.5.5
    - 1.1.1.1
    - 8.8.8.8
  nameserver:
    - https://1.1.1.1/dns-query
    - https://dns.google/dns-query
  fallback:
    - tls://1.1.1.1:853
    - tls://dns.google:853
DEOF
        fi
        
        # ═══════════════════════════════════════════
        # STEP 7: AUTO-ADD LOAD BALANCE GROUP
        # If user has proxies but only 1 group, add LB group
        # ═══════════════════════════════════════════
        
        PROXY_COUNT=$(grep -c "^  - name:" "$TMP")
        GROUP_COUNT=$(grep -c "^  - name:" "$TMP" | head -1)
        
        # Only if we have proxies and no ⚡ Load-Balance group exists
        if [ "$PROXY_COUNT" -gt 5 ] && ! grep -q "⚡ Load-Balance" "$TMP"; then
            # Extract all proxy names
            PROXIES=$(awk '/^proxies:/,/^proxy-groups:/' "$TMP" | grep "^  - name:" | sed 's/  - name: //' | head -50)
            
            # Find where proxy-groups starts
            if grep -q "^proxy-groups:" "$TMP"; then
                # Insert Load-Balance group after "proxy-groups:"
                LB_GROUP='  - name: "⚡ Load-Balance"\
    type: load-balance\
    strategy: consistent-hashing\
    url: https://www.gstatic.com/generate_204\
    interval: 180\
    lazy: true\
    proxies:'
                
                # This is complex - user can manually add if needed
                # For now, just optimize existing groups
                :
            fi
        fi
        
        # ═══════════════════════════════════════════
        # STEP 8: LAN safety rules
        # ═══════════════════════════════════════════
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        LAN_NET=$(echo "$LAN_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')
        
        if grep -q '^rules:' "$TMP"; then
            sed -i '/192.168.87.0\/24,DIRECT/d' "$TMP"
            sed -i '/192.168.64.0\/24,DIRECT/d' "$TMP"
            
            if ! grep -q "$LAN_NET,DIRECT" "$TMP"; then
                sed -i "/^rules:/a\\
  - 'IP-CIDR,$LAN_NET,DIRECT,no-resolve'\\
  - 'DST-PORT,9595,DIRECT'" "$TMP"
            fi
        fi
        
        # ═══════════════════════════════════════════
        # STEP 9: Validate & Apply
        # ═══════════════════════════════════════════
        if /usr/bin/mihomo -d /etc/mihomo -f "$TMP" -t 2>/tmp/mhcfg_err.log; then
            cp /etc/mihomo/config.yaml /etc/mihomo/config.yaml.bak 2>/dev/null
            mv "$TMP" /etc/mihomo/config.yaml
            
            # Save user preferences
            echo "1" > /etc/mihomo/transparent
            echo "1" > /etc/mihomo/enabled
            
            /etc/init.d/mihomo restart >/dev/null 2>&1
            
            echo "SAVED"
        else
            ERR=$(cat /tmp/mhcfg_err.log 2>/dev/null | head -3)
            rm -f "$TMP" /tmp/mhcfg_err.log
            echo "INVALID YAML: $ERR"
        fi
    else
        rm -f "$TMP"
        echo "EMPTY"
    fi
else
    cat /etc/mihomo/config.yaml 2>/dev/null
fi
