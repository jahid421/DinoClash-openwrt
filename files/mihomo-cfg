#!/bin/sh
# ═══════════════════════════════════════════════
# 🦕 DinoClash - Ultra Smart YAML Auto-Optimizer
# Auto Smart Routing (Games/Apps/Downloads)
# Developer: Jahid Hasan Shuvo
# ═══════════════════════════════════════════════

echo "Content-Type: text/plain"
echo ""

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/mhcfg_$$.yaml"
    trap "rm -f ${TMP}.opt ${TMP}.lazy ${TMP}.new /tmp/mhcfg_err.log" EXIT
    cat > "$TMP"
    
    if [ -s "$TMP" ]; then
        # STEP 1: SPEED OPTIMIZATION
        awk '
        BEGIN { in_group=0 }
        /^  - name:/ { in_group=1 }
        /^[a-z]/ && !/^  / { in_group=0 }
        {
            if (in_group && /^    strategy: round-robin$/) {
                print "    strategy: consistent-hashing"
                next
            }
            print
        }
        ' "$TMP" > "${TMP}.opt" && mv "${TMP}.opt" "$TMP"
        
        sed -i 's/interval: 300/interval: 120/g' "$TMP"
        sed -i 's/interval: 600/interval: 120/g' "$TMP"
        sed -i 's/interval: 900/interval: 120/g' "$TMP"
        sed -i 's/interval: 180/interval: 120/g' "$TMP"
        sed -i 's/tolerance: 50/tolerance: 20/g' "$TMP"
        sed -i 's/tolerance: 100/tolerance: 20/g' "$TMP"
        
        # Remove problematic BD GeoIP
        sed -i '/GEOIP,BD,DIRECT/d' "$TMP"
        sed -i '/GEOIP,LAN,DIRECT/d' "$TMP"
        
        awk '
        BEGIN { in_urltest=0; has_lazy=0 }
        /^  - name:/ {
            if (in_urltest && !has_lazy) print "    lazy: true"
            in_urltest=0; has_lazy=0
        }
        /^    type: url-test/ { in_urltest=1 }
        /^    lazy:/ { has_lazy=1 }
        /^[a-z]/ && !/^  / {
            if (in_urltest && !has_lazy) print "    lazy: true"
            in_urltest=0; has_lazy=0
        }
        { print }
        END { if (in_urltest && !has_lazy) print "    lazy: true" }
        ' "$TMP" > "${TMP}.lazy" && mv "${TMP}.lazy" "$TMP"
        
        # STEP 2: REQUIRED SETTINGS
        add_if_missing() {
            local key="$1"
            local line="$2"
            if ! grep -q "^${key}" "$TMP"; then
                { echo "$line"; cat "$TMP"; } > "${TMP}.new" && mv "${TMP}.new" "$TMP"
            fi
        }
        
        add_if_missing "mixed-port:" "mixed-port: 7890"
        add_if_missing "redir-port:" "redir-port: 7892"
        add_if_missing "allow-lan:" "allow-lan: true"
        add_if_missing "bind-address:" "bind-address: '*'"
        add_if_missing "mode:" "mode: rule"
        add_if_missing "log-level:" "log-level: info"
        add_if_missing "ipv6:" "ipv6: false"
        
        grep -q '^external-controller:' "$TMP" || echo 'external-controller: 0.0.0.0:9595' >> "$TMP"
        grep -q '^external-ui:' "$TMP" || echo 'external-ui: /etc/mihomo/ui' >> "$TMP"
        grep -q '^secret:' "$TMP" || echo 'secret: "flclash123"' >> "$TMP"
        grep -q '^geodata-mode:' "$TMP" || echo 'geodata-mode: true' >> "$TMP"
        grep -q '^geodata-loader:' "$TMP" || echo 'geodata-loader: standard' >> "$TMP"
        grep -q '^find-process-mode:' "$TMP" || echo 'find-process-mode: "off"' >> "$TMP"
        grep -q '^global-client-fingerprint:' "$TMP" || echo 'global-client-fingerprint: chrome' >> "$TMP"
        grep -q '^tcp-concurrent:' "$TMP" || echo 'tcp-concurrent: true' >> "$TMP"
        grep -q '^unified-delay:' "$TMP" || echo 'unified-delay: true' >> "$TMP"
        grep -q '^keep-alive-interval:' "$TMP" || echo 'keep-alive-interval: 10' >> "$TMP"
        grep -q '^keep-alive-idle:' "$TMP" || echo 'keep-alive-idle: 10' >> "$TMP"
        
        # STEP 3: PROFILE
        if ! grep -q '^profile:' "$TMP"; then
            cat >> "$TMP" << 'PEOF'

profile:
  store-selected: true
  store-fake-ip: true
  tracing: false
PEOF
        fi
        
        # STEP 4: SNIFFER
        if ! grep -q '^sniffer:' "$TMP"; then
            cat >> "$TMP" << 'SEOF'

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]
SEOF
        fi
        
        # STEP 5: TUN (disabled - transparent mode)
        if ! grep -q '^tun:' "$TMP"; then
            cat >> "$TMP" << 'TEOF'

tun:
  enable: false
  stack: system
  device: utun
  auto-route: true
  auto-detect-interface: true
  strict-route: false
  mtu: 1500
  dns-hijack:
    - "any:53"
  inet4-address:
    - 172.19.0.1/30
TEOF
        else
            sed -i '/^tun:/,/^[a-z]/ s/^  enable: true$/  enable: false/' "$TMP"
        fi
        
        # STEP 6: DNS
        if ! grep -q '^dns:' "$TMP"; then
            cat >> "$TMP" << 'DEOF'

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: redir-host
  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8
    - 223.5.5.5
    - 114.114.114.114
  nameserver:
    - https://1.1.1.1/dns-query
    - https://dns.google/dns-query
  fallback:
    - tls://1.1.1.1:853
    - tls://dns.google:853
  nameserver-policy:
    '+.google.com': 'https://dns.google/dns-query'
    '+.facebook.com': 'https://1.1.1.1/dns-query'
    '+.youtube.com': 'https://dns.google/dns-query'
DEOF
        else
            sed -i 's/enhanced-mode: fake-ip/enhanced-mode: redir-host/g' "$TMP"
            sed -i 's/prefer-h3: true/prefer-h3: false/g' "$TMP"
        fi
        
        # STEP 7: SMART AUTO-ROUTING RULES
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        LAN_NET=$(echo "$LAN_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')
        
        if grep -q '^rules:' "$TMP"; then
            sed -i '/192.168.87.0\/24,DIRECT/d' "$TMP"
            sed -i '/192.168.64.0\/24,DIRECT/d' "$TMP"
            
            # Add smart routing rules if not present
            if ! grep -q "# DinoClash Smart Routing" "$TMP"; then
                sed -i "/^rules:/a\\
  # DinoClash Smart Routing\\
  # ═══ LAN Safety (DIRECT) ═══\\
  - 'IP-CIDR,$LAN_NET,DIRECT,no-resolve'\\
  - 'IP-CIDR,192.168.0.0/16,DIRECT,no-resolve'\\
  - 'IP-CIDR,10.0.0.0/8,DIRECT,no-resolve'\\
  - 'IP-CIDR,172.16.0.0/12,DIRECT,no-resolve'\\
  - 'IP-CIDR,127.0.0.0/8,DIRECT,no-resolve'\\
  - 'IP-CIDR,100.64.0.0/10,DIRECT,no-resolve'\\
  - 'IP-CIDR,224.0.0.0/4,DIRECT,no-resolve'\\
  - 'DOMAIN-SUFFIX,local,DIRECT'\\
  - 'DOMAIN-SUFFIX,lan,DIRECT'\\
  - 'DST-PORT,9595,DIRECT'\\
  # ═══ Games (Play - DIRECT for low latency) ═══\\
  - 'DOMAIN-KEYWORD,pubg,DIRECT'\\
  - 'DOMAIN-KEYWORD,freefire,DIRECT'\\
  - 'DOMAIN-KEYWORD,garena,DIRECT'\\
  - 'DOMAIN-KEYWORD,valorant,DIRECT'\\
  - 'DOMAIN-KEYWORD,fortnite,DIRECT'\\
  - 'DOMAIN-KEYWORD,codm,DIRECT'\\
  - 'DOMAIN-KEYWORD,tencent,DIRECT'\\
  - 'DOMAIN-KEYWORD,riotgames,DIRECT'\\
  # ═══ Game Updates/Downloads (PROXY for speed) ═══\\
  - 'DOMAIN-SUFFIX,epicgames.com,Proxy'\\
  - 'DOMAIN-SUFFIX,steampowered.com,Proxy'\\
  - 'DOMAIN-SUFFIX,steamcontent.com,Proxy'\\
  - 'DOMAIN-SUFFIX,steamcommunity.com,Proxy'\\
  - 'DOMAIN-SUFFIX,steamstatic.com,Proxy'\\
  - 'DOMAIN-SUFFIX,battle.net,Proxy'\\
  - 'DOMAIN-SUFFIX,blizzard.com,Proxy'\\
  - 'DOMAIN-SUFFIX,riotcdn.net,Proxy'\\
  - 'DOMAIN-SUFFIX,akamaized.net,Proxy'\\
  - 'DOMAIN-SUFFIX,cloudfront.net,Proxy'\\
  - 'DOMAIN-KEYWORD,download,Proxy'\\
  - 'DOMAIN-KEYWORD,update,Proxy'\\
  - 'DOMAIN-KEYWORD,cdn,Proxy'\\
  # ═══ Real-time Apps (DIRECT for low latency) ═══\\
  - 'DOMAIN-SUFFIX,ultraviewer.net,DIRECT'\\
  - 'DOMAIN-KEYWORD,ultraviewer,DIRECT'\\
  - 'DOMAIN-SUFFIX,anydesk.com,DIRECT'\\
  - 'DOMAIN-KEYWORD,anydesk,DIRECT'\\
  - 'DOMAIN-SUFFIX,teamviewer.com,DIRECT'\\
  - 'DOMAIN-KEYWORD,teamviewer,DIRECT'\\
  - 'DOMAIN-SUFFIX,rustdesk.com,DIRECT'\\
  - 'DOMAIN-KEYWORD,rustdesk,DIRECT'\\
  # ═══ Voice/Video Calls (DIRECT) ═══\\
  - 'DOMAIN-SUFFIX,zoom.us,DIRECT'\\
  - 'DOMAIN-KEYWORD,zoom,DIRECT'\\
  - 'DOMAIN-SUFFIX,teams.microsoft.com,DIRECT'\\
  - 'DOMAIN-KEYWORD,skype,DIRECT'\\
  - 'DOMAIN-SUFFIX,webex.com,DIRECT'\\
  - 'DOMAIN-SUFFIX,gotomeeting.com,DIRECT'\\
  # ═══ Chat Apps (DIRECT - faster) ═══\\
  - 'DOMAIN-SUFFIX,whatsapp.com,DIRECT'\\
  - 'DOMAIN-SUFFIX,whatsapp.net,DIRECT'\\
  - 'DOMAIN-KEYWORD,whatsapp,DIRECT'\\
  - 'DOMAIN-SUFFIX,messenger.com,DIRECT'\\
  - 'DOMAIN-KEYWORD,messenger,DIRECT'\\
  - 'DOMAIN-SUFFIX,fbcdn.net,DIRECT'\\
  - 'DOMAIN-SUFFIX,telegram.org,DIRECT'\\
  - 'DOMAIN-SUFFIX,t.me,DIRECT'\\
  - 'DOMAIN-KEYWORD,telegram,DIRECT'\\
  - 'DOMAIN-SUFFIX,discord.com,DIRECT'\\
  - 'DOMAIN-SUFFIX,discord.gg,DIRECT'\\
  - 'DOMAIN-SUFFIX,discordapp.com,DIRECT'\\
  - 'DOMAIN-KEYWORD,discord,DIRECT'\\
  - 'DOMAIN-SUFFIX,linkedin.com,DIRECT'\\
  - 'DOMAIN-KEYWORD,linkedin,DIRECT'\\
  - 'DOMAIN-SUFFIX,slack.com,DIRECT'\\
  # ═══ Banking & Payment (DIRECT - security) ═══\\
  - 'DOMAIN-KEYWORD,bkash,DIRECT'\\
  - 'DOMAIN-KEYWORD,nagad,DIRECT'\\
  - 'DOMAIN-KEYWORD,rocket,DIRECT'\\
  - 'DOMAIN-KEYWORD,upay,DIRECT'\\
  - 'DOMAIN-KEYWORD,bank,DIRECT'\\
  - 'DOMAIN-KEYWORD,dbbl,DIRECT'\\
  - 'DOMAIN-KEYWORD,brac,DIRECT'\\
  - 'DOMAIN-KEYWORD,islami,DIRECT'\\
  - 'DOMAIN-KEYWORD,citybank,DIRECT'\\
  - 'DOMAIN-KEYWORD,dutchbangla,DIRECT'\\
  # ═══ Bangladesh Apps (DIRECT - local) ═══\\
  - 'DOMAIN-SUFFIX,gp.com.bd,DIRECT'\\
  - 'DOMAIN-SUFFIX,robi.com.bd,DIRECT'\\
  - 'DOMAIN-SUFFIX,banglalink.com.bd,DIRECT'\\
  - 'DOMAIN-SUFFIX,teletalk.com.bd,DIRECT'\\
  - 'DOMAIN-SUFFIX,daraz.com.bd,DIRECT'\\
  - 'DOMAIN-SUFFIX,pathao.com,DIRECT'\\
  - 'DOMAIN-SUFFIX,foodpanda.com.bd,DIRECT'\\
  - 'DOMAIN-SUFFIX,com.bd,DIRECT'\\
  # ═══ UDP High Ports (Games, WebRTC) → DIRECT ═══\\
  - 'DST-PORT,3478,DIRECT'\\
  - 'DST-PORT,10000-20000,DIRECT'\\
  - 'DST-PORT,17000-27000,DIRECT'\\
  - 'DST-PORT,50000-65535,DIRECT'\\
  # ═══ Everything else → PROXY (fast download speed) ═══" "$TMP"
            fi
        fi
        
        # STEP 8: VALIDATE & APPLY
        if /usr/bin/mihomo -d /etc/mihomo -f "$TMP" -t 2>/tmp/mhcfg_err.log; then
            cp /etc/mihomo/config.yaml /etc/mihomo/config.yaml.bak 2>/dev/null
            mv "$TMP" /etc/mihomo/config.yaml
            echo "1" > /etc/mihomo/transparent
            echo "1" > /etc/mihomo/enabled
            /etc/init.d/mihomo restart >/dev/null 2>&1
            echo "SAVED"
        else
            ERR=$(cat /tmp/mhcfg_err.log 2>/dev/null | head -3)
            rm -f "$TMP"
            echo "INVALID YAML: $ERR"
        fi
    else
        rm -f "$TMP"
        echo "EMPTY"
    fi
else
    cat /etc/mihomo/config.yaml 2>/dev/null
fi
