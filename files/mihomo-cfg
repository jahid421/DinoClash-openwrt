#!/bin/sh
# ═══════════════════════════════════════════════
# 🦕 DinoClash - Smart Auto-Config Engine
# Works like OpenClash / FLClash
# Developer: Jahid Hasan Shuvo
# ═══════════════════════════════════════════════

echo "Content-Type: text/plain"
echo ""

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/mhcfg_$$.yaml"
    trap "rm -f ${TMP}.opt ${TMP}.lazy ${TMP}.new /tmp/mhcfg_err.log /tmp/dcproxy_$$" EXIT
    cat > "$TMP"
    
    if [ -s "$TMP" ]; then
    
        # SPEED OPTIMIZATION
        awk '
        BEGIN { in_group=0 }
        /^  - name:/ { in_group=1 }
        /^[a-z]/ && !/^  / { in_group=0 }
        {
            if (in_group && /^    strategy: round-robin$/) {
                print "    strategy: consistent-hashing"
                next
            }
            print
        }
        ' "$TMP" > "${TMP}.opt" && mv "${TMP}.opt" "$TMP"
        
        sed -i 's/interval: 300/interval: 120/g' "$TMP"
        sed -i 's/interval: 600/interval: 120/g' "$TMP"
        sed -i 's/interval: 900/interval: 120/g' "$TMP"
        sed -i 's/interval: 180/interval: 120/g' "$TMP"
        sed -i 's/tolerance: 50/tolerance: 20/g' "$TMP"
        sed -i 's/tolerance: 100/tolerance: 20/g' "$TMP"
        sed -i '/GEOIP,BD,DIRECT/d' "$TMP"
        sed -i '/GEOIP,LAN,DIRECT/d' "$TMP"
        
        awk '
        BEGIN { in_urltest=0; has_lazy=0 }
        /^  - name:/ {
            if (in_urltest && !has_lazy) print "    lazy: true"
            in_urltest=0; has_lazy=0
        }
        /^    type: url-test/ { in_urltest=1 }
        /^    lazy:/ { has_lazy=1 }
        /^[a-z]/ && !/^  / {
            if (in_urltest && !has_lazy) print "    lazy: true"
            in_urltest=0; has_lazy=0
        }
        { print }
        END { if (in_urltest && !has_lazy) print "    lazy: true" }
        ' "$TMP" > "${TMP}.lazy" && mv "${TMP}.lazy" "$TMP"
        
        # BASIC SETTINGS
        add_if_missing() {
            if ! grep -q "^${1}" "$TMP"; then
                { echo "$2"; cat "$TMP"; } > "${TMP}.new" && mv "${TMP}.new" "$TMP"
            fi
        }
        
        add_if_missing "mixed-port:" "mixed-port: 7890"
        add_if_missing "redir-port:" "redir-port: 7892"
        add_if_missing "allow-lan:" "allow-lan: true"
        add_if_missing "bind-address:" "bind-address: '*'"
        add_if_missing "mode:" "mode: rule"
        add_if_missing "log-level:" "log-level: info"
        add_if_missing "ipv6:" "ipv6: false"
        
        grep -q '^external-controller:' "$TMP" || echo 'external-controller: 0.0.0.0:9595' >> "$TMP"
        grep -q '^external-ui:' "$TMP" || echo 'external-ui: /etc/mihomo/ui' >> "$TMP"
        grep -q '^secret:' "$TMP" || echo 'secret: "flclash123"' >> "$TMP"
        grep -q '^geodata-mode:' "$TMP" || echo 'geodata-mode: true' >> "$TMP"
        grep -q '^geodata-loader:' "$TMP" || echo 'geodata-loader: standard' >> "$TMP"
        grep -q '^find-process-mode:' "$TMP" || echo 'find-process-mode: "off"' >> "$TMP"
        grep -q '^global-client-fingerprint:' "$TMP" || echo 'global-client-fingerprint: chrome' >> "$TMP"
        grep -q '^tcp-concurrent:' "$TMP" || echo 'tcp-concurrent: true' >> "$TMP"
        grep -q '^unified-delay:' "$TMP" || echo 'unified-delay: true' >> "$TMP"
        grep -q '^keep-alive-interval:' "$TMP" || echo 'keep-alive-interval: 10' >> "$TMP"
        grep -q '^keep-alive-idle:' "$TMP" || echo 'keep-alive-idle: 10' >> "$TMP"
        
        # PROFILE
        if ! grep -q '^profile:' "$TMP"; then
            cat >> "$TMP" << 'PEOF'

profile:
  store-selected: true
  store-fake-ip: true
  tracing: false
PEOF
        fi
        
        # SNIFFER
        if ! grep -q '^sniffer:' "$TMP"; then
            cat >> "$TMP" << 'SEOF'

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]
SEOF
        fi
        
        # TUN
        if ! grep -q '^tun:' "$TMP"; then
            cat >> "$TMP" << 'TEOF'

tun:
  enable: false
  stack: system
  device: utun
  auto-route: true
  auto-detect-interface: true
  strict-route: false
  mtu: 1500
  dns-hijack:
    - "any:53"
  inet4-address:
    - 172.19.0.1/30
TEOF
        else
            sed -i '/^tun:/,/^[a-z]/ s/^  enable: true$/  enable: false/' "$TMP"
        fi
        
        # DNS
        if ! grep -q '^dns:' "$TMP"; then
            cat >> "$TMP" << 'DEOF'

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: redir-host
  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8
    - 223.5.5.5
    - 114.114.114.114
  nameserver:
    - https://1.1.1.1/dns-query
    - https://dns.google/dns-query
  fallback:
    - tls://1.1.1.1:853
    - tls://dns.google:853
DEOF
        else
            sed -i 's/enhanced-mode: fake-ip/enhanced-mode: redir-host/g' "$TMP"
            sed -i 's/prefer-h3: true/prefer-h3: false/g' "$TMP"
        fi
        
        # AUTO-DETECT PROXY TYPES (no emoji - safe)
        rm -f /tmp/dcproxy_$$
        
        awk '
        /^proxies:/ { inp=1; next }
        /^[a-z]/ && !/^  / && !/^proxies:/ { inp=0 }
        inp && /^  - name:/ {
            n=$0; sub(/.*name: */, "", n); gsub(/["'"'"']/, "", n); gsub(/^ *| *$/, "", n)
            cn=n
        }
        inp && /^    type: *http$/ { print "H|" cn }
        inp && /type: *socks5/ { print "S|" cn }
        inp && /type: *ss$/ { print "A|" cn }
        inp && /type: *vmess/ { print "A|" cn }
        inp && /type: *vless/ { print "A|" cn }
        inp && /type: *trojan/ { print "A|" cn }
        ' "$TMP" | sort -t'|' -k2 -u > /tmp/dcproxy_$$
        
        HC=$(grep -c "^H|" /tmp/dcproxy_$$ 2>/dev/null || echo 0)
        SC=$(grep -c "^S|" /tmp/dcproxy_$$ 2>/dev/null || echo 0)
        AC=$(grep -c "^A|" /tmp/dcproxy_$$ 2>/dev/null || echo 0)
        TOTAL=$((HC + SC + AC))
        
        if [ "$TOTAL" -gt 0 ]; then
            # Remove old proxy-groups
            if grep -q '^proxy-groups:' "$TMP"; then
                awk '
                /^proxy-groups:/ { s=1; next }
                s && /^[a-z]/ && !/^  / { s=0 }
                !s
                ' "$TMP" > "${TMP}.new" && mv "${TMP}.new" "$TMP"
            fi
            
            # Remove old rules
            if grep -q '^rules:' "$TMP"; then
                awk '
                /^rules:/ { s=1; next }
                s && /^[a-z]/ && !/^  / { s=0 }
                !s
                ' "$TMP" > "${TMP}.new" && mv "${TMP}.new" "$TMP"
            fi
            
            # BUILD PROXY GROUPS (no emoji)
            {
                echo ""
                echo "proxy-groups:"
                
                if [ "$HC" -gt 0 ]; then
                    echo "  - name: \"Fast Speed\""
                    echo "    type: url-test"
                    echo "    proxies:"
                    grep "^H|" /tmp/dcproxy_$$ | cut -d'|' -f2 | while IFS= read -r n; do
                        echo "      - \"$n\""
                    done
                    echo "    url: http://www.gstatic.com/generate_204"
                    echo "    interval: 120"
                    echo "    tolerance: 20"
                    echo "    lazy: true"
                fi
                
                if [ "$SC" -gt 0 ]; then
                    echo "  - name: \"UDP Apps\""
                    echo "    type: url-test"
                    echo "    proxies:"
                    grep "^S|" /tmp/dcproxy_$$ | cut -d'|' -f2 | while IFS= read -r n; do
                        echo "      - \"$n\""
                    done
                    echo "    url: http://www.gstatic.com/generate_204"
                    echo "    interval: 120"
                    echo "    tolerance: 20"
                    echo "    lazy: true"
                fi
                
                if [ "$AC" -gt 0 ]; then
                    echo "  - name: \"Advanced\""
                    echo "    type: url-test"
                    echo "    proxies:"
                    grep "^A|" /tmp/dcproxy_$$ | cut -d'|' -f2 | while IFS= read -r n; do
                        echo "      - \"$n\""
                    done
                    echo "    url: http://www.gstatic.com/generate_204"
                    echo "    interval: 120"
                    echo "    tolerance: 20"
                    echo "    lazy: true"
                fi
                
                echo "  - name: \"Proxy\""
                echo "    type: select"
                echo "    proxies:"
                [ "$HC" -gt 0 ] && echo "      - \"Fast Speed\""
                [ "$SC" -gt 0 ] && echo "      - \"UDP Apps\""
                [ "$AC" -gt 0 ] && echo "      - \"Advanced\""
                echo "      - DIRECT"
                
                echo "  - name: \"Streaming\""
                echo "    type: select"
                echo "    proxies:"
                [ "$HC" -gt 0 ] && echo "      - \"Fast Speed\""
                [ "$AC" -gt 0 ] && echo "      - \"Advanced\""
                [ "$SC" -gt 0 ] && echo "      - \"UDP Apps\""
                echo "      - DIRECT"
                
                echo "  - name: \"Downloads\""
                echo "    type: select"
                echo "    proxies:"
                [ "$HC" -gt 0 ] && echo "      - \"Fast Speed\""
                [ "$AC" -gt 0 ] && echo "      - \"Advanced\""
                echo "      - DIRECT"
                
                echo "  - name: \"Games\""
                echo "    type: select"
                echo "    proxies:"
                [ "$SC" -gt 0 ] && echo "      - \"UDP Apps\""
                [ "$AC" -gt 0 ] && echo "      - \"Advanced\""
                echo "      - DIRECT"
                
                echo "  - name: \"RealTime\""
                echo "    type: select"
                echo "    proxies:"
                [ "$SC" -gt 0 ] && echo "      - \"UDP Apps\""
                [ "$AC" -gt 0 ] && echo "      - \"Advanced\""
                echo "      - DIRECT"
                
            } >> "$TMP"
            
            # BUILD RULES (no emoji)
            LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
            LAN_NET=$(echo "$LAN_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')
            
            {
                echo ""
                echo "rules:"
                echo "  - 'IP-CIDR,$LAN_NET,DIRECT,no-resolve'"
                echo "  - 'IP-CIDR,192.168.0.0/16,DIRECT,no-resolve'"
                echo "  - 'IP-CIDR,10.0.0.0/8,DIRECT,no-resolve'"
                echo "  - 'IP-CIDR,172.16.0.0/12,DIRECT,no-resolve'"
                echo "  - 'IP-CIDR,127.0.0.0/8,DIRECT,no-resolve'"
                echo "  - 'IP-CIDR,100.64.0.0/10,DIRECT,no-resolve'"
                echo "  - 'IP-CIDR,224.0.0.0/4,DIRECT,no-resolve'"
                echo "  - 'DOMAIN-SUFFIX,local,DIRECT'"
                echo "  - 'DOMAIN-SUFFIX,lan,DIRECT'"
                echo "  - 'DST-PORT,9595,DIRECT'"
                echo "  - 'DOMAIN-SUFFIX,com.bd,DIRECT'"
                echo "  - 'DOMAIN-SUFFIX,gov.bd,DIRECT'"
                echo "  - 'DOMAIN-KEYWORD,bkash,DIRECT'"
                echo "  - 'DOMAIN-KEYWORD,nagad,DIRECT'"
                echo "  - 'DOMAIN-KEYWORD,rocket,DIRECT'"
                echo "  - 'DOMAIN-KEYWORD,bank,DIRECT'"
                echo "  - 'DOMAIN-KEYWORD,daraz,DIRECT'"
                echo "  - 'DOMAIN-KEYWORD,pathao,DIRECT'"
                echo "  - 'DOMAIN-SUFFIX,youtube.com,Streaming'"
                echo "  - 'DOMAIN-SUFFIX,googlevideo.com,Streaming'"
                echo "  - 'DOMAIN-SUFFIX,ytimg.com,Streaming'"
                echo "  - 'DOMAIN-SUFFIX,netflix.com,Streaming'"
                echo "  - 'DOMAIN-SUFFIX,nflxvideo.net,Streaming'"
                echo "  - 'DOMAIN-SUFFIX,twitch.tv,Streaming'"
                echo "  - 'DOMAIN-SUFFIX,disney.com,Streaming'"
                echo "  - 'DOMAIN-SUFFIX,hulu.com,Streaming'"
                echo "  - 'DOMAIN-SUFFIX,primevideo.com,Streaming'"
                echo "  - 'DOMAIN-KEYWORD,download,Downloads'"
                echo "  - 'DOMAIN-KEYWORD,update,Downloads'"
                echo "  - 'DOMAIN-KEYWORD,cdn,Downloads'"
                echo "  - 'DOMAIN-SUFFIX,akamaized.net,Downloads'"
                echo "  - 'DOMAIN-SUFFIX,cloudfront.net,Downloads'"
                echo "  - 'DOMAIN-SUFFIX,steamcontent.com,Downloads'"
                echo "  - 'DOMAIN-SUFFIX,steampowered.com,Downloads'"
                echo "  - 'DOMAIN-SUFFIX,epicgames.com,Downloads'"
                echo "  - 'DOMAIN-SUFFIX,battle.net,Downloads'"
                echo "  - 'DOMAIN-KEYWORD,pubg,Games'"
                echo "  - 'DOMAIN-KEYWORD,freefire,Games'"
                echo "  - 'DOMAIN-KEYWORD,garena,Games'"
                echo "  - 'DOMAIN-KEYWORD,valorant,Games'"
                echo "  - 'DOMAIN-KEYWORD,fortnite,Games'"
                echo "  - 'DOMAIN-KEYWORD,tencent,Games'"
                echo "  - 'DOMAIN-KEYWORD,riotgames,Games'"
                echo "  - 'DOMAIN-KEYWORD,zoom,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,teams,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,skype,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,discord,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,whatsapp,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,messenger,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,telegram,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,ultraviewer,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,anydesk,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,teamviewer,RealTime'"
                echo "  - 'DOMAIN-KEYWORD,rustdesk,RealTime'"
                echo "  - 'MATCH,Proxy'"
            } >> "$TMP"
        fi
        
        rm -f /tmp/dcproxy_$$
        
        # VALIDATE & APPLY
        if /usr/bin/mihomo -d /etc/mihomo -f "$TMP" -t 2>/tmp/mhcfg_err.log; then
            cp /etc/mihomo/config.yaml /etc/mihomo/config.yaml.bak 2>/dev/null
            mv "$TMP" /etc/mihomo/config.yaml
            echo "1" > /etc/mihomo/transparent
            echo "1" > /etc/mihomo/enabled
            /etc/init.d/mihomo restart >/dev/null 2>&1
            echo "SAVED"
        else
            ERR=$(cat /tmp/mhcfg_err.log 2>/dev/null | head -3)
            rm -f "$TMP"
            echo "INVALID YAML: $ERR"
        fi
    else
        rm -f "$TMP"
        echo "EMPTY"
    fi
else
    cat /etc/mihomo/config.yaml 2>/dev/null
fi
